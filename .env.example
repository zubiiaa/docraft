# Copy this file to .env.local and fill in real values. Never commit .env.local.

# MongoDB Atlas connection string, including the database name "docraft"
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/docraft?retryWrites=true&w=majority

# Long random string used to sign session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-a-long-random-string
